# Configuração do Assistente de Refeições
# Copie este arquivo para .env e preencha com suas credenciais

# === OpenAI API (Whisper + GPT) ===
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Join API (Notificações Android) ===
# Obtenha em: https://joinjoaomgcd.appspot.com/
JOIN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JOIN_DEVICE_ID=seu_dispositivo_android

# === n8n Configuration ===
# URL do webhook n8n (após deploy)
N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/voz-refeicao

# === Opcional: Whisper Local ===
# Se preferir usar Whisper localmente ao invés da API OpenAI
WHISPER_LOCAL=false
WHISPER_MODEL_PATH=/path/to/whisper/model

# === Configurações do Android ===
# Package do app Tecnonutri
TECNONUTRI_PACKAGE=br.com.tecnonutri

# === Configurações de Idioma ===
LANGUAGE=pt-BR
TIMEZONE=America/Sao_Paulo
